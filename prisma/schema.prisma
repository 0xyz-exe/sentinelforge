generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  repoPath    String?
  baseUrl     String?
  environment String   @default("development")
  owner       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  scans       Scan[]
  findings    Finding[]

  @@map("projects")
}

model Scan {
  id          String   @id @default(cuid())
  projectId   String
  scanner     String
  scannerVer  String?
  status      String   @default("pending")
  startedAt   DateTime @default(now())
  completedAt DateTime?
  exitCode    Int?
  config      String?
  
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  findings    Finding[]

  @@map("scans")
  @@index([projectId])
  @@index([status])
}

model Finding {
  id          String   @id @default(cuid())
  projectId   String
  scanId      String
  scanner     String
  ruleId      String?
  title       String
  description String?
  severity    String
  confidence  String   @default("medium")
  cwe         String?
  filePath    String?
  lineNumber  Int?
  evidence    String?
  remediation String?
  status      String   @default("open")
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())
  resolvedAt  DateTime?
  
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scan        Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@map("findings")
  @@index([projectId])
  @@index([scanId])
  @@index([status])
  @@index([severity])
}
